generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

enum Role {
  USER
  ADMIN
}

enum VideoCategory {
  AD
  BUSINESS
  ENTERTAINMENT
  GIFTS
  PRODUCTS
}

enum LeadStatus {
  NEW
  CONTACTED
  QUALIFIED
  LOST
}

enum ChatSide {
  USER
  BOT
}

enum GenerationKind {
  IMAGE
  VIDEO
}

enum GenerationStatus {
  QUEUED
  CREATED
  IN_PROGRESS
  COMPLETED
  FAILED
}

model User {
  id            String   @id @default(cuid())
  email         String   @unique
  passwordHash  String
  role          Role     @default(USER)
  firstName     String?
  lastName      String?
  /** Аккумулятивный остаток кредитов (можно пополнять админом). */
  credits       Int      @default(0)
  /** Дневной лимит, сбрасывается каждые сутки. */
  dailyCredits  Int      @default(50)
  dailyUsed     Int      @default(0)
  dailyResetAt  DateTime @default(now())
  createdAt     DateTime @default(now())

  jobs          GenerationJob[]
  usage         UsageLog[]
}

model GenerationJob {
  id             String           @id @default(cuid())
  userId         String
  user           User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  kind           GenerationKind
  modelId        String           // id модели из каталога (mystic, flux-dev, kling-v2-5-pro, seedance-pro-1080p)
  status         GenerationStatus @default(QUEUED)
  freepikTaskId  String?
  prompt         String
  params         String           // JSON с исходными параметрами
  resultUrls     String?          // JSON массив URL после COMPLETED
  creditsCost    Int              @default(0)
  errorMessage   String?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  @@index([userId, createdAt])
  @@index([freepikTaskId])
}

model UsageLog {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  jobId      String?
  action     String   // generate_image, generate_video, upload_reference, ...
  modelId    String?
  cost       Int      @default(0)
  createdAt  DateTime @default(now())

  @@index([userId, createdAt])
}

model Video {
  id          String        @id @default(cuid())
  title       String
  category    VideoCategory
  posterUrl   String
  videoUrl    String
  published   Boolean       @default(true)
  sortOrder   Int           @default(0)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
}

model Service {
  id          String  @id @default(cuid())
  title       String
  description String
  iconKey     String
  sortOrder   Int     @default(0)
  published   Boolean @default(true)
}

model Tariff {
  id          String  @id @default(cuid())
  name        String
  price       String
  description String
  features    String // JSON array of strings
  highlighted Boolean @default(false)
  sortOrder   Int     @default(0)
  published   Boolean @default(true)
}

model Advantage {
  id          String  @id @default(cuid())
  title       String
  description String
  iconKey     String
  sortOrder   Int     @default(0)
  published   Boolean @default(true)
}

model HeroBanner {
  id                 Int     @id @default(1)
  headline           String
  subheadline        String
  ctaPrimaryLabel    String
  ctaPrimaryHref     String
  ctaSecondaryLabel  String
  ctaSecondaryHref   String
  previewImageUrl    String?
  /** Фоновое видео баннера (URL после загрузки в /uploads/banner или внешняя ссылка) */
  heroVideoUrl       String?
  ctaBoxTitle        String  @default("Начать бесплатно")
  ctaBoxSubtitle     String  @default("Оставьте контакт — пришлём доступ в песочницу")
  updatedAt          DateTime @updatedAt
}

model Product {
  id          String  @id @default(cuid())
  title       String
  description String
  imageUrl    String?
  sortOrder   Int     @default(0)
  published   Boolean @default(true)
}

model ChatDemoLine {
  id        String   @id @default(cuid())
  sortOrder Int
  side      ChatSide
  text      String
}

model Lead {
  id        String     @id @default(cuid())
  name      String
  phone     String
  source    String     @default("landing")
  status    LeadStatus @default(NEW)
  createdAt DateTime   @default(now())
}
