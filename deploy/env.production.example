# Скопируйте в /var/www/rinulik-build/.env на сервере (см. deploy/DEPLOY.md).

# SQLite: абсолютный путь надёжнее при PM2
DATABASE_URL="file:/var/www/rinulik-build/prisma/prod.db"

JWT_SECRET="сгенерируйте-длинную-случайную-строку-минимум-32-символа"

# Порт процесса Node (должен совпадать с proxy_pass в nginx)
PORT=4010

# Origin браузера для CORS (ваш публичный URL без слэша в конце)
FRONTEND_ORIGIN="https://rinulik.neeklo.ru"

# Для SPA apiFetch оставьте пустым при работе с тем же доменом через nginx
# VITE_API_URL=

# Чат на лендинге (сервер Node вызывает Ollama; не путать с браузером)
# OLLAMA_URL="http://127.0.0.1:11434"
# OLLAMA_MODEL="llama3:8b"
